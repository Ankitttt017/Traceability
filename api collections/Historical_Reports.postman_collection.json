{
  "info": {
    "name": "Historical Reports API",
    "description": "Clean collection for Historical Reports. Run Login first to get TOKEN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://192.168.100.136:9090/api/v1",
      "description": "Backend API base URL"
    },
    {
      "key": "TOKEN",
      "value": "",
      "description": "Saved by Login collection"
    },
    {
      "key": "DATE_FROM",
      "value": "2026-07-31T06:00:00",
      "description": "Production day start"
    },
    {
      "key": "DATE_TO",
      "value": "2026-08-01T06:00:00",
      "description": "Production day end"
    },
    {
      "key": "PAGE",
      "value": "1"
    },
    {
      "key": "PAGE_SIZE",
      "value": "1000"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Historical Report - Data",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/historical?dateFrom={{DATE_FROM}}&dateTo={{DATE_TO}}&page={{PAGE}}&pageSize={{PAGE_SIZE}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "historical"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "{{DATE_FROM}}"
            },
            {
              "key": "dateTo",
              "value": "{{DATE_TO}}"
            },
            {
              "key": "page",
              "value": "{{PAGE}}"
            },
            {
              "key": "pageSize",
              "value": "{{PAGE_SIZE}}"
            }
          ]
        }
      }
    },
    {
      "name": "2. Historical Report - Export",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/historical/export?dateFrom={{DATE_FROM}}&dateTo={{DATE_TO}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "historical",
            "export"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "{{DATE_FROM}}"
            },
            {
              "key": "dateTo",
              "value": "{{DATE_TO}}"
            }
          ]
        }
      }
    },
    {
      "name": "3. Historical Report - Manual Sync",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/historical/sync",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "historical",
            "sync"
          ]
        }
      }
    }
  ]
}