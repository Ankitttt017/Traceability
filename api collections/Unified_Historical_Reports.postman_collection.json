{
  "info": {
    "name": "Traceability - Unified Reports API",
    "description": "Unified collection containing Login and Historical Reports (with Casted Parts and Other Parts filtering).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://192.168.100.136:9090/api/v1",
      "description": "Server base URL"
    },
    {
      "key": "TOKEN",
      "value": "",
      "description": "Auto-filled after Login succeeds - do not edit manually"
    },
    {
      "key": "DATE_FROM",
      "value": "2026-07-31T06:00:00",
      "description": "Production day start"
    },
    {
      "key": "DATE_TO",
      "value": "2026-08-01T06:00:00",
      "description": "Production day end"
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.token) {",
              "    pm.collectionVariables.set(\"TOKEN\", jsonData.token);",
              "    console.log(\"Token extracted and saved to collection variables successfully.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/auth/login",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Historical Report (Casted Parts - HPDC)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{TOKEN}}"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/historical?dateFrom={{DATE_FROM}}&dateTo={{DATE_TO}}&page=1&pageSize=1000&partCategory=HPDC&clean=1",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "historical"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "{{DATE_FROM}}"
            },
            {
              "key": "dateTo",
              "value": "{{DATE_TO}}"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "1000"
            },
            {
              "key": "partCategory",
              "value": "HPDC",
              "description": "Filters only casted parts (with shot details)"
            },
            {
              "key": "clean",
              "value": "1",
              "description": "Returns professional nested JSON format"
            }
          ]
        }
      }
    },
    {
      "name": "3. Historical Report (Other Parts)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{TOKEN}}"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/historical?dateFrom={{DATE_FROM}}&dateTo={{DATE_TO}}&page=1&pageSize=1000&partCategory=OTHER&clean=1",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "historical"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "{{DATE_FROM}}"
            },
            {
              "key": "dateTo",
              "value": "{{DATE_TO}}"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "1000"
            },
            {
              "key": "partCategory",
              "value": "OTHER",
              "description": "Filters only manual/customer parts (no shot details)"
            },
            {
              "key": "clean",
              "value": "1",
              "description": "Returns professional nested JSON format"
            }
          ]
        }
      }
    }
  ]
}
