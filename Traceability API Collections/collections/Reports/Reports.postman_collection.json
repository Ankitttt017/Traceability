{
  "info": {
    "name": "Reports",
    "description": "Simple professional report API collection.\n\nRun Login first. Login saves TOKEN.\n\nKeep filters simple:\n- DATE_FROM / DATE_TO for production day range\n- SHIFT_CODE = ALL, SHIFT_A, SHIFT_B, etc.\n- Oil Pan K-12 request uses lineName + partName + dieCastingMachine\n- Search request accepts part ID, customer QR, or shot number in SEARCH_VALUE\n\nAll report-data requests use clean=1 so Postman response is easy to read: records, summary, pagination, shot details, leak test, and rejection fields.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://192.168.100.136:9090/api/v1",
      "description": "Backend API base URL"
    },
    {
      "key": "TOKEN",
      "value": "",
      "description": "Saved by Login collection"
    },
    {
      "key": "DATE_FROM",
      "value": "2026-07-31T06:00:00",
      "description": "Production day start"
    },
    {
      "key": "DATE_TO",
      "value": "2026-08-01T06:00:00",
      "description": "Production day end"
    },
    {
      "key": "SHIFT_CODE",
      "value": "ALL",
      "description": "Use ALL, SHIFT_A, SHIFT_B, etc."
    },
    {
      "key": "PAGE",
      "value": "1"
    },
    {
      "key": "PAGE_SIZE",
      "value": "50"
    },
    {
      "key": "LINE_NAME",
      "value": "OIL PAN K-12"
    },
    {
      "key": "PART_NAME",
      "value": "OPK12"
    },
    {
      "key": "DIE_CASTING_MACHINE",
      "value": "UBE 850 T - 02"
    },
    {
      "key": "SEARCH_VALUE",
      "value": "",
      "description": "Part ID, customer QR, or shot number"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Report - Date + Shift",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/data?dateFrom={{DATE_FROM}}&dateTo={{DATE_TO}}&shiftCode={{SHIFT_CODE}}&page={{PAGE}}&pageSize={{PAGE_SIZE}}&clean=1&full=1&fast=false&includePlcReadings=1&includeLeaktest=1&includePlcSummary=1&noCache=1",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "data"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "{{DATE_FROM}}"
            },
            {
              "key": "dateTo",
              "value": "{{DATE_TO}}"
            },
            {
              "key": "shiftCode",
              "value": "{{SHIFT_CODE}}",
              "description": "ALL means no shift filter"
            },
            {
              "key": "page",
              "value": "{{PAGE}}"
            },
            {
              "key": "pageSize",
              "value": "{{PAGE_SIZE}}"
            },
            {
              "key": "clean",
              "value": "1"
            },
            {
              "key": "full",
              "value": "1"
            },
            {
              "key": "fast",
              "value": "false"
            },
            {
              "key": "includePlcReadings",
              "value": "1"
            },
            {
              "key": "includeLeaktest",
              "value": "1"
            },
            {
              "key": "includePlcSummary",
              "value": "1"
            },
            {
              "key": "noCache",
              "value": "1"
            }
          ]
        },
        "description": "Basic report records with date and shift only. Response includes records[], summary, pagination, and shot details."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Clean response has records and summary', () => {",
              "  pm.expect(json).to.have.property('records');",
              "  pm.expect(json).to.have.property('summary');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Report - Oil Pan K-12",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/data?dateFrom={{DATE_FROM}}&dateTo={{DATE_TO}}&shiftCode={{SHIFT_CODE}}&lineName={{LINE_NAME}}&partName={{PART_NAME}}&dieCastingMachine={{DIE_CASTING_MACHINE}}&page={{PAGE}}&pageSize={{PAGE_SIZE}}&clean=1&full=1&fast=false&includePlcReadings=1&includeLeaktest=1&includePlcSummary=1&noCache=1",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "data"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "{{DATE_FROM}}"
            },
            {
              "key": "dateTo",
              "value": "{{DATE_TO}}"
            },
            {
              "key": "shiftCode",
              "value": "{{SHIFT_CODE}}"
            },
            {
              "key": "lineName",
              "value": "{{LINE_NAME}}"
            },
            {
              "key": "partName",
              "value": "{{PART_NAME}}"
            },
            {
              "key": "dieCastingMachine",
              "value": "{{DIE_CASTING_MACHINE}}"
            },
            {
              "key": "page",
              "value": "{{PAGE}}"
            },
            {
              "key": "pageSize",
              "value": "{{PAGE_SIZE}}"
            },
            {
              "key": "clean",
              "value": "1"
            },
            {
              "key": "full",
              "value": "1"
            },
            {
              "key": "fast",
              "value": "false"
            },
            {
              "key": "includePlcReadings",
              "value": "1"
            },
            {
              "key": "includeLeaktest",
              "value": "1"
            },
            {
              "key": "includePlcSummary",
              "value": "1"
            },
            {
              "key": "noCache",
              "value": "1"
            }
          ]
        },
        "description": "Oil Pan K-12 report with PLC shot details. Kept simple: date, shift, line, part, and die-casting machine."
      }
    },
    {
      "name": "3. Report - Search Part / Customer / Shot",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/data?dateFrom={{DATE_FROM}}&dateTo={{DATE_TO}}&shiftCode={{SHIFT_CODE}}&barcode={{SEARCH_VALUE}}&page=1&pageSize=20&clean=1&full=1&fast=false&includePlcReadings=1&includeLeaktest=1&includePlcSummary=1&noCache=1",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "data"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "{{DATE_FROM}}"
            },
            {
              "key": "dateTo",
              "value": "{{DATE_TO}}"
            },
            {
              "key": "shiftCode",
              "value": "{{SHIFT_CODE}}"
            },
            {
              "key": "barcode",
              "value": "{{SEARCH_VALUE}}",
              "description": "Part ID, customer QR, or shot number"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            },
            {
              "key": "clean",
              "value": "1"
            },
            {
              "key": "full",
              "value": "1"
            },
            {
              "key": "fast",
              "value": "false"
            },
            {
              "key": "includePlcReadings",
              "value": "1"
            },
            {
              "key": "includeLeaktest",
              "value": "1"
            },
            {
              "key": "includePlcSummary",
              "value": "1"
            },
            {
              "key": "noCache",
              "value": "1"
            }
          ]
        },
        "description": "Paste part ID, customer QR, or shot number into SEARCH_VALUE. Same clean response format."
      }
    },
    {
      "name": "4. Shot Summary - Machine",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/reports/report/shot-summary?dateFrom={{DATE_FROM}}&dateTo={{DATE_TO}}&shiftCode={{SHIFT_CODE}}&dieCastingMachine={{DIE_CASTING_MACHINE}}&noCache=1",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "reports",
            "report",
            "shot-summary"
          ],
          "query": [
            {
              "key": "dateFrom",
              "value": "{{DATE_FROM}}"
            },
            {
              "key": "dateTo",
              "value": "{{DATE_TO}}"
            },
            {
              "key": "shiftCode",
              "value": "{{SHIFT_CODE}}"
            },
            {
              "key": "dieCastingMachine",
              "value": "{{DIE_CASTING_MACHINE}}"
            },
            {
              "key": "noCache",
              "value": "1"
            }
          ]
        },
        "description": "Only the machine shot cards: total, OK, warm-up, NG."
      }
    }
  ]
}
